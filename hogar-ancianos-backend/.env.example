# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=hogar_user
DB_PASSWORD=your_secure_password_here
DB_NAME=hogar_db

# Configuración JWT
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION=8h

# Configuración CORS (URL del frontend)
FRONTEND_URL=http://localhost:5173

# Configuración SSL para PostgreSQL en producción (Railway)
DB_SSL=false

# Configuración SOUT (Sistema de Autenticación Universitaria)
# SOUT_CLIENT_ID=your_client_id
# SOUT_CLIENT_SECRET=your_client_secret
# SOUT_REDIRECT_URI=http://localhost:3000/api/auth/sout/callback
