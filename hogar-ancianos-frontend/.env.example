# URL del BFF (Backend for Frontend)
# En desarrollo, apuntar al BFF local (sin /api)
VITE_BFF_URL=http://localhost:4000

# En producción, usar la URL del BFF desplegado (sin /api)
# VITE_BFF_URL=https://tu-bff.railway.app

# Compatibilidad legado (opcional)
# VITE_API_URL=http://localhost:4000/api
