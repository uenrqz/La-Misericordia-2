# Configuración de Producción - BFF La Misericordia 2
# Este archivo documenta las variables necesarias en Render

# Modo de ejecución
NODE_ENV=production

# Puerto (Render lo asigna automáticamente)
PORT=4000

# URL del Backend en Render
BACKEND_URL=https://tu-backend.onrender.com

# URLs del Frontend permitidas (separadas por comas)
FRONTEND_URL=https://lamisericordiaapp.vercel.app
FRONTEND_DOMAIN=https://lamisericordiaapp.vercel.app

# Configuración JWT (usar el mismo secret que el backend)
JWT_SECRET=tu_secret_super_seguro_aqui_cambiar_en_produccion

# Timeout para requests al backend (ms)
BACKEND_TIMEOUT=30000
