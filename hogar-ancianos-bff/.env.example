# Configuración del BFF (Backend For Frontend)

# Entorno de ejecución
NODE_ENV=development  # development | production

# Puerto del servidor BFF
PORT=4000

# URL del Backend (API principal)
API_URL=http://localhost:3000
API_TIMEOUT=10000
API_RETRIES=2

# Configuración JWT del BFF
JWT_SECRET=your_bff_jwt_secret_key_32_characters_minimum
JWT_EXPIRATION=8h

# Configuración del proxy
PROXY_TIMEOUT=15000

# URL del Frontend (para CORS)
FRONTEND_URL=http://localhost:5174

# Configuración de logs
LOG_LEVEL=info  # info | debug | error
DEBUG=false     # true para logs detallados

# Producción: Configurar estas variables en Railway
# NODE_ENV=production
# API_URL=https://tu-backend.railway.app
# FRONTEND_URL=https://tu-frontend.vercel.app
